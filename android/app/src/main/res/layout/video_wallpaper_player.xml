<?xml version="1.0" encoding="utf-8"?>
<!--
  视频壁纸专用的 PlayerView 布局。

  surface_type 必须在 XML inflate 时就定下来——PlayerView 在构造函数里直接读这个属性
  决定往内容帧里塞一个 SurfaceView 还是 TextureView，运行时没有对应的 setter。
  用 texture_view 是为了让 Haze 的 RenderNode 快照能看见这一层画面（见 HomeScreen.kt 里
  VideoWallpaper 的注释），代价是比 surface_view 多一次 GPU 拷贝，桌面壁纸这个分辨率/帧率
  可以接受。

  use_controller=false：壁纸不需要播放控制条。
  resize_mode=zoom：按屏幕比例裁切填满（等价于 ContentScale.Crop），而不是留黑边。
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_wallpaper_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom"
    app:shutter_background_color="@android:color/black" />
